#!/usr/bin/env python3
# document_loader — carga y muestra archivos de texto de forma interactiva
#
# Uso:
#   ./document_loader [ruta_al_archivo]   # ejecución directa (python3)
#   python3 document_loader [ruta]        # explícito
#   lua document_loader.lua [ruta]        # si lua está instalado (ver notas abajo)
#
# Si no se pasa ruta, pide una interactivamente.
#
# Notas:
#   - Este archivo es 100% Python. No requiere lua ni ningún intérprete extra.
#   - Si prefieres usar lua donde está disponible, puedes crear un symlink o wrapper:
#       ln -s $(pwd)/document_loader document_loader.lua
#     y luego: lua document_loader.lua archivo.md
#   - La versión lua pura se encuentra en tools/document_loader_pure.lua.

from __future__ import annotations

import os
import sys


def read_file(path: str) -> str:
    """Lee un archivo completo y lo devuelve como string."""
    try:
        with open(path, "r", encoding="utf-8") as f:
            return f.read()
    except OSError as err:
        print(f"No se pudo abrir '{path}': {err}", file=sys.stderr)
        sys.exit(1)


def prompt_file() -> str:
    """Solicita al usuario la ruta de un archivo si no se proporcionó por arg."""
    sys.stdout.write("Path al archivo: ")
    sys.stdout.flush()
    path = sys.stdin.readline()
    path = path.strip()
    if not path:
        print("No se proporcionó ruta.", file=sys.stderr)
        sys.exit(1)
    return path


def main() -> None:
    file_path = sys.argv[1] if len(sys.argv) > 1 else None
    path = file_path or prompt_file()

    content = read_file(path)
    sys.stdout.write(content)


if __name__ == "__main__":
    main()
