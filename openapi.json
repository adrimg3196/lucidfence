{
  "openapi": "3.1.0",
  "info": {
    "title": "LucidFence Local API",
    "version": "2.1.0",
    "description": "Versioned, tenant-isolated local API with a governed autonomous geofencing company. Browser sessions or lf_ bearer API keys are required except for health and schema endpoints."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8765/api/v2"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerApiKey": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "lf_ API key"
      },
      "browserSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "gf_session"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "const": "ok"
          },
          "service": {
            "const": "lucidfence"
          }
        }
      },
      "CompanyGoal": {
        "type": "object",
        "required": [
          "title",
          "outcome",
          "metrics"
        ],
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 160
          },
          "outcome": {
            "type": "string",
            "maxLength": 500
          },
          "metrics": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object"
            }
          },
          "priority": {
            "enum": [
              "p0",
              "p1",
              "p2"
            ]
          },
          "autonomy": {
            "enum": [
              "observe",
              "recommend",
              "simulate",
              "execute_safe"
            ]
          }
        }
      },
      "CompanyTask": {
        "type": "object",
        "required": [
          "id",
          "action",
          "risk",
          "status",
          "evidence",
          "acceptance"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "risk": {
            "enum": [
              "low",
              "medium",
              "high",
              "forbidden"
            ]
          },
          "status": {
            "enum": [
              "proposed",
              "executed",
              "blocked",
              "ready_for_handoff",
              "rejected"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "acceptance": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "requires_approvals": {
            "type": "integer"
          },
          "result": {
            "type": [
              "object",
              "null"
            ]
          }
        }
      }
    }
  },
  "security": [
    {
      "bearerApiKey": []
    },
    {
      "browserSession": []
    }
  ],
  "paths": {
    "/status": {
      "get": {
