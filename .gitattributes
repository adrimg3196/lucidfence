# .gitattributes — lo que se EXCLUYE del release de cliente (brew install / tarball).
# El repo mantiene estos archivos para nuestro desarrollo; el cliente NO los baja.
# git archive respeta export-ignore al generar el tarball del release.

# Desarrollo interno de la empresa (no del cliente).
# Se excluyen las carpetas internas de docs/, no docs/ entero: git archive no
# desciende en un directorio excluido, así que un -export-ignore de un fichero
# de dentro nunca lo re-incluiría. El cliente se lleva docs/architecture,
# docs/operations y docs/product, que son las guías que enlaza el README.
docs/internal/          export-ignore
docs/roadmap/           export-ignore
docs/gtm/               export-ignore
docs/agents/            export-ignore
docs/references/        export-ignore
docs/superpowers/       export-ignore
lucidfence/mcp/applivery_mcp.py export-ignore
.agents/                 export-ignore
.claude/                 export-ignore
Formula/                 export-ignore
data/cloud_tenants/      export-ignore
data/actions_log.jsonl   export-ignore
data/cloud_state.json    export-ignore
data/device_states.json  export-ignore
data/dwell.json          export-ignore
data/events.jsonl        export-ignore
data/stats_history.jsonl export-ignore
data/traction_history.json export-ignore
data/trails.jsonl        export-ignore

# Deploy nuestro (no del cliente)
fly.toml                 export-ignore
scripts/deploy_fly.sh            export-ignore
scripts/start_all.sh             export-ignore
scripts/start_local.sh           export-ignore
scripts/docker_start.sh          export-ignore
scripts/geofence_daily_report.sh export-ignore

# Tests / QA internos (el cliente no los corre)
tests/                   export-ignore
scripts/qa_saas.py       export-ignore

# Build nuestro
scripts/build.sh                 export-ignore
apps/macos/              export-ignore
artifact.tar              export-ignore

# Metadatos
.github/                 export-ignore

# ─────────────────────────────────────────────────────────────────────────────
# Merge de fricción-cero para archivos generados / append-only (ver tarea
# t_e207227e). Objetivo: cortar conflictos crónicos del merge train (#118).
#
# Logs append-only de los loops: TODOs/loops distintos escriben líneas al final
# de forma concurrente. `merge=union` concatena ambos lados sin conflicto.
# NO son export-ignore para git (solo export-ignore excluye del tarball de
# release, no del merge). Son append-only por contrato documentado:
#   - docs/internal/LOOP.md, loop-admin-value.md, release/README.md,
#     trends/README.md, security/README.md, growth/README.md, roadmap/README.md
# NOTA: docs/internal/STATE.md es REESCRITO (no append) por los loops → no va aquí.
docs/internal/loop-run-log.md              merge=union
docs/internal/release/history.md           merge=union
docs/internal/trends/signals.md            merge=union
docs/internal/security/findings.md         merge=union
docs/internal/growth/experiments.md        merge=union
docs/internal/growth/mentions.md           merge=union

# Índice de adapters (lucidfence/plugins/adapters/index.json):
#   - NO merge=union: es JSON; union dejaría "}{" inválido (probado empíricamente).
#   - NO merge=ours: "ours" NO es driver integrado (probado: sigue en conflicto).
#   - Contiene sha256 de los .py; tests/test_annual_roadmap.py lo verifica, así
#     que un índice con hashes obsoletos rompe CI. El merge correcto es
#     REGENERARLO desde los .py mergeados con scripts/build_adapter_index.py,
#     vía el driver custom `regen-adapter-index` registrado en .git/config
#     (ver CONTRIBUTING.md → "Setup del repo").
lucidfence/plugins/adapters/index.json     merge=regen-adapter-index

# data/*.jsonl son append-only por naturaleza, pero están gitignored
# (data/*.jsonl en .gitignore) → no entran en merges. No hace falta atributo.

