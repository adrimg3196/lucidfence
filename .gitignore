# === LucidFence — .gitignore (open-source, multi-MDM) ===
# Nunca subir datos de tenant, secretos ni runtime.

# Datos de tenant (cada cliente en su propio dir; locales y confidenciales)
data/tenants/
data/*.tmp
data/*.log
data/geocode_cache.db
data/reports/

# Config con secretos en runtime (el repo trae config.example.json)
config.json
*.local.json

# Logs
logs/
*.log
/tmp/

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
env/

# Entorno / secretos
.env
.env.*
!.env.example

# Runtime session/user data (no versionar; confidenciales)
data/_sessions.json
data/_users.json
data/_roles.json

# Runtime state volátil (se regenera al arrancar; nunca versionar)
data/*.jsonl
data/device_states.json
data/dwell.json
data/events.jsonl
data/stats_history.jsonl
data/traction_history.json

# Escaneos de seguridad y herramientas externas (no son del producto)
strix_runs/
.strix*
.strix-venv/
.strix_instruction.md
.strix_run.sh
ROADMAP.md
loop_improve.py.bak

# Build output
dist/
build/
*.tar.gz

# OS
.DS_Store
.AppleDouble

# Edge deps de skill refs (fuera del repo del producto)
.skills-refs/

# Node (si se añaden herramientas JS)
node_modules/
moa/

.worktrees/
.superpowers/

# graphify knowledge graph (local tooling, not product)
graphify-out/
.graphify_chunk_*.json

# SBOM: artefacto de build, lo genera CI (issue #74)
sbom.cdx.json
data/cloud_state.json
design-work/*.html
!design-work/*.dc.html
